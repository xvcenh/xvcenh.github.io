---
layout: null
permalink: /search-index.json
sitemap: false
---
[{% for post in site.posts %}{% assign keywords = post.keywords | join: ' ' %}{
  "url": {{ post.url | relative_url | jsonify }},
  "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
  "categories": {{ post.categories | jsonify }},
  "keywords": {{ post.keywords | jsonify }},
  "title": {{ post.title | jsonify }},
  "topics": {{ post.categories | join: ' ' | append: ' ' | append: keywords | jsonify }},
  "body": {{ post.content | strip_html | normalize_whitespace | jsonify }}
}{% unless forloop.last %},{% endunless %}{% endfor %}]
